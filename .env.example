# Copiar a .env y llenar con los datos del proyecto (Dashboard > Project Settings > API Keys).
# Son valores públicos del cliente (van dentro de la app), pero no se versionan.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) o la legacy anon key; ambas sirven.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Login con Google (opcional). Poner en true solo cuando el proveedor esté configurado en Supabase.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
